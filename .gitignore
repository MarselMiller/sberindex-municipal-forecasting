.venv/
/.venv-chronos/
__pycache__/
*.pyc
.pytest_cache/
.vscode/
/build/
/dist/
/temp/
/tmp/
.ipynb_checkpoints/
*.egg-info/
# Данные и модельные результаты предоставлены пользователю приватно.
# Не публиковать автоматически, особенно справочник и географические файлы.
data/input/*
!data/input/.gitkeep
# E06b: private source snapshots and per-document derived data.
/data/external/news_raw/
# F7: исходные архивы, справочники и непроверенные материалы не публикуются.
/data/raw/
/data/private/
/data/restricted/
outputs/*
!outputs/.gitkeep
catboost_info/
# Секреты и архивы
.env
.env.*
*.pem
*.key
*.zip
*.rar
*.7z

# Временно не публикуем до проверки сохранённых выводов и содержимого
/notebooks/
/reports/*
!/reports/final/
/reports/final/*
# F6: проверенный итоговый audit; остальные локальные reports остаются приватными.
!/reports/final/FINAL_AUDIT.md
# F7: только проверенный отчёт о публикации данных.
!/reports/final/DATA_PUBLICATION_AUDIT.md
# Проверенный содержательный аудит готовности к сдаче; без новых данных.
!/reports/final/SUBMISSION_READINESS.md

# Проверенные агрегаты методологической ablation National/Local Persistence.
!/reports/results/
/reports/results/*
!/reports/results/national_local_persistence.md
!/reports/results/national_local_persistence/
/reports/results/national_local_persistence/*
!/reports/results/national_local_persistence/metrics.csv
!/reports/results/national_local_persistence/origin_deltas.csv
!/reports/results/national_local_persistence/origin_stability.csv
!/reports/results/national_local_persistence/municipality_win_rates.csv
!/reports/results/national_local_persistence/gap_analysis.csv
!/reports/results/national_local_persistence/run_manifest.json

# Только сводные агрегаты forecasting robustness; per-MO audit остаётся локальным.
!/reports/results/forecast_robustness.md
!/reports/results/forecast_robustness/
/reports/results/forecast_robustness/*
!/reports/results/forecast_robustness/pairwise_metrics.csv
!/reports/results/forecast_robustness/municipality_summary.csv
!/reports/results/forecast_robustness/origin_deltas.csv
!/reports/results/forecast_robustness/origin_summary.csv
!/reports/results/forecast_robustness/bootstrap_origin.csv
!/reports/results/forecast_robustness/bootstrap_municipality.csv
!/reports/results/forecast_robustness/concentration.csv
!/reports/results/forecast_robustness/applicability_checks.csv
!/reports/results/forecast_robustness/run_manifest.json
